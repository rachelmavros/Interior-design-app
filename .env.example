# ── Required ────────────────────────────────────────────
# Google Lens + Google Shopping results (serpapi.com)
SERP_KEY=
# Temporary public image hosting so Google Lens can see your crop (api.imgbb.com)
IMGBB_KEY=
# AI room editing (platform.openai.com → API keys). Your org may need to be verified for image models.
OPENAI_API_KEY=

# Inspo photos (unsplash.com/developers → New Application → Access Key). Free.
UNSPLASH_ACCESS_KEY=

# Accounts (Sign in with Google), cloud saves and daily AI limits — see README "Accounts".
# Supabase → Project Settings → API keys. The publishable (or legacy anon) key is safe to expose;
# the secret (or legacy service_role) key must stay private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Google emails that get admin (Best quality, no daily limit).
ADMIN_EMAILS=
# Daily AI edits (defaults shown): signed-out per device, signed-in per account, per network backstop.
FREE_EDITS_PER_DAY=3
ACCOUNT_EDITS_PER_DAY=15
NETWORK_EDITS_PER_DAY=10

# ── Optional ────────────────────────────────────────────
# Default image model visitors start on (they can switch in the studio):
#   gpt-image-1-mini (Budget) · gpt-image-1.5 (Balanced) · gpt-image-2 (Premium)
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Optional: limit which models visitors can pick, comma-separated. Default: all three.
OPENAI_ALLOWED_MODELS=

# If set, visitors must enter this code before using AI or search (protects your API spend).
APP_ACCESS_CODE=

# Affiliate links — set whichever programs you're approved for. Unset = plain retailer links.
# Amazon Associates tracking tag, e.g. yourtag-20 (only applied to amazon.* links)
AMAZON_ASSOCIATE_TAG=
# Sovrn Commerce (formerly VigLink) API key — wraps links for thousands of retailers
SOVRN_API_KEY=
# Skimlinks publisher/site ID, e.g. 123456X789012 — used if Sovrn isn't set
SKIMLINKS_ID=

# Shown on /privacy as the contact address
CONTACT_EMAIL=

# Local development without any keys: fake search results and fake AI edits.
MOCK_APIS=
